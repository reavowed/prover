A binary operator is a binary function that acts purely within a single set.

term baseSet (X)
  name (base set)
  format (baseSet(X))
  (= $0 domain domain t0)

type binaryOperation ∘ (infix-function)
  qualifier (A) (on A)
  name (binary operation)
  definition (function t0 product t1 t1 t1)

theorem Alternative Definition for Binary Operation on a Set
termVariables(∘ 0 (infix-function), A 0)
conclusion ↔ binaryOperation t0 t1 function t0 product t1 t1 t1

property associative on binaryOperation
  definition (∀ a → ∈ $0 t1 ∀ b → ∈ $0 t1 ∀ c → ∈ $0 t1 = apply t0 orderedPair $$$0 apply t0 orderedPair $$0 $0 apply t0 orderedPair apply t0 orderedPair $$$0 $$0 $0)

property commutative on binaryOperation
  definition (∀ a → ∈ $0 t1 ∀ b → ∈ $0 t1 = apply t0 orderedPair $$0 $0 apply t0 orderedPair $0 $$0)

comment Identities.

relatedObject identity e for binaryOperation
  definition (∧ ∈ t0 t2 ∀ a → ∈ $0 t2 ∧ = apply t1 orderedPair $0 t0 $0 = apply t1 orderedPair t0 $0 $0)

theorem Identities are Unique
termVariables(∘ 0 (infix-function), e_1 0, e_2 0, A 0)
premise binaryOperation t0 t3
premise identityBinaryOperation t1 t0 t3
premise identityBinaryOperation t2 t0 t3
conclusion = t1 t2

comment Cancellable operators.

property leftCancellable on binaryOperation
  name (left-cancellable)
  definition (∀ a → ∈ $0 t1 ∀ b → ∈ $0 t1 ∀ c → ∈ $0 t1 → = apply t0 orderedPair $$$0 $$0 apply t0 orderedPair $$$0 $0 = $$0 $0)

property rightCancellable on binaryOperation
  name (right-cancellable)
  definition (∀ a → ∈ $0 t1 ∀ b → ∈ $0 t1 ∀ c → ∈ $0 t1 → = apply t0 orderedPair $$$0 $0 apply t0 orderedPair $$0 $0 = $$$0 $$0)

property cancellable on binaryOperation
  definition (∧ leftCancellableBinaryOperation t0 t1 rightCancellableBinaryOperation t0 t1)

theorem A Commutative Operator Is Cancellable If It Is Cancellable on One Side
termVariables(∘ 0 (infix-function), A 0)
premise ∧ binaryOperation t0 t1 commutativeBinaryOperation t0 t1
premise ∨ leftCancellableBinaryOperation t0 t1 rightCancellableBinaryOperation t0 t1
conclusion cancellableBinaryOperation t0 t1

comment Invertible operators.

property invertible on binaryOperation
  parentObjects (identity)
  definition (∀ a → ∈ $0 t1 ∃ b ∧ ∈ $0 t1 ∧ = apply t0 orderedPair $$0 $0 $$$0 = apply t0 orderedPair $0 $$0 $$$0)

relatedObject invertingOperation f for binaryOperation
  parentObjects (identity)
  name (inverting operation)
  definition (∧ unaryOperation t0 t2 ∀ a → ∈ $0 t2 ∧ = apply t1 orderedPair $0 apply t0 $0 $$0 = apply t1 orderedPair apply t0 $0 $0 $$0)

relatedObject inverseOperation ∗ (infix-function) for binaryOperation
  name (inverse operation)
  definition (∧ binaryOperation t0 t2 ∀ a → ∈ $0 t2 ∀ b → ∈ $0 t2 = apply t0 orderedPair apply t1 orderedPair $$0 $0 $0 $$0)

theorem An Invertible Binary Operation Is Cancellable
termVariables(∘ 0 (infix-function), A 0)
premise ∧ ∧ binaryOperation t0 t1 associativeBinaryOperation t0 t1 invertibleBinaryOperation t0 t1
conclusion cancellableBinaryOperation t0 t1

theorem Direct Invertibility Condition for Binary Operator
termVariables(∘ 0 (infix-function), e 0, A 0)
premise ∧ binaryOperation t0 t2 identityBinaryOperation t1 t0 t2
premise ∀ a → ∈ $0 t2 ∃ b ∧ ∈ $0 t2 ∧ = apply t0 orderedPair $$0 $0 t1 = apply t0 orderedPair $0 $$0 t1
conclusion invertibleBinaryOperation t0 t2

theorem Relationship Between Inverting Operation and Inverse Operation
termVariables(∘ 0 (infix-function), ∗ 0 (infix-function), f 0, A 0)
premise ∧ ∧ ∧ binaryOperation t0 t3 associativeBinaryOperation t0 t3 inverseOperationBinaryOperation t1 t0 t3 invertingOperationBinaryOperation t2 t0 t3
conclusion ∀ a → ∈ $0 t3 ∀ b → ∈ $0 t3 = apply t1 orderedPair $$0 $0 apply t0 orderedPair $$0 apply t2 $0

theorem Associative Invertible Binary Operation Has Unique Inverses
termVariables(∘ 0 (infix-function), A 0, e 0)
premise ∧ ∧ ∧ binaryOperation t0 t1 associativeBinaryOperation t0 t1 invertibleBinaryOperation t0 t1 identityBinaryOperation t2 t0 t1
conclusion ∀ a → ∈ $0 t1 ∃! b ∧ ∈ $0 t1 ∧ = apply t0 orderedPair $$0 $0 t2 = apply t0 orderedPair $0 $$0 t2

theorem Associative Invertible Binary Operation Has Unique Inverting Operation
termVariables(∘ 0 (infix-function), A 0, e 0)
premise ∧ ∧ ∧ binaryOperation t0 t1 associativeBinaryOperation t0 t1 invertibleBinaryOperation t0 t1 identityBinaryOperation t2 t0 t1
conclusion ∃! f invertingOperationBinaryOperation $0 t0 t1

theorem Associative Invertible Binary Operation Has Unique Inverse Operation
termVariables(∘ 0 (infix-function), A 0, e 0)
premise ∧ ∧ ∧ binaryOperation t0 t1 associativeBinaryOperation t0 t1 invertibleBinaryOperation t0 t1 identityBinaryOperation t2 t0 t1
conclusion ∃! ∗ inverseOperationBinaryOperation $0 t0 t1

comment Distributivity of operators.

typeRelation leftDistributes (left-distributes over) binaryOperation ∘ (infix-function) A binaryOperation ∗ (infix-function) A
  name (left distributivity)
  definition (∀ a → ∈ $0 t2 ∀ b → ∈ $0 t2 ∀ c → ∈ $0 t2 = apply t0 orderedPair $$$0 apply t1 orderedPair $$0 $0 apply t1 orderedPair apply t0 orderedPair $$$0 $$0 apply t0 orderedPair $$$0 $0)

typeRelation rightDistributes (right-distributes over) binaryOperation ∘ (infix-function) A binaryOperation ∗ (infix-function) A
  name (right distributivity)
  definition (∀ a → ∈ $0 t2 ∀ b → ∈ $0 t2 ∀ c → ∈ $0 t2 = apply t0 orderedPair apply t1 orderedPair $$$0 $$0 $0 apply t1 orderedPair apply t0 orderedPair $$$0 $0 apply t0 orderedPair $$0 $0)

typeRelation distributes (distributes over) binaryOperation ∘ (infix-function) A binaryOperation ∗ (infix-function) A
  name (distributivity)
  definition (∧ leftDistributes t0 t1 t2 rightDistributes t0 t1 t2)

theorem A Commutative Operator Distributes If It Distributes on One Side
termVariables(∘ 0 (infix-function), ∗ 0 (infix-function), A 0)
premise ∧ binaryOperation t0 t2 commutativeBinaryOperation t0 t2
premise binaryOperation t1 t2
premise ∨ leftDistributes t0 t1 t2 rightDistributes t0 t1 t2
conclusion distributes t0 t1 t2
